SNG_CONTROL_BASE_URL=https://localhost:7265
SNG_CONTROL_TIMEOUT_SECONDS=30

# Optional for startup. API key required for chat and voice; model for chat and /voice.
OPENAI_API_KEY=
SNG_INTELLIGENCE_MODEL=

# Optional Voice. Examples: gpt-4o-mini-transcribe, gpt-4o-mini-tts.
# Configure only models and a built-in voice available to your OpenAI project.
SNG_INTELLIGENCE_TRANSCRIPTION_MODEL=
SNG_INTELLIGENCE_TRANSCRIPTION_LANGUAGE=es
SNG_INTELLIGENCE_SPEECH_MODEL=
# Current provisional selection; configurable, not an application fallback/default.
SNG_INTELLIGENCE_VOICE=marin

