SNG_CONTROL_BASE_URL=https://localhost:7265
SNG_CONTROL_TIMEOUT_SECONDS=30

# Optional for startup. API key required for chat and voice; model for chat and /voice.
OPENAI_API_KEY=
SNG_INTELLIGENCE_MODEL=

# Optional Voice. Examples: gpt-4o-mini-transcribe, gpt-4o-mini-tts.
# Configure only models and a built-in voice available to your OpenAI project.
SNG_INTELLIGENCE_TRANSCRIPTION_MODEL=
SNG_INTELLIGENCE_TRANSCRIPTION_LANGUAGE=es
SNG_INTELLIGENCE_SPEECH_MODEL=
# Current provisional selection; configurable, not an application fallback/default.
SNG_INTELLIGENCE_VOICE=marin

# Optional Realtime Voice 2C sideband support; uses the same server-only OPENAI_API_KEY.
# Configure models available to your OpenAI project. No startup dependency on Live.
SNG_INTELLIGENCE_LIVE_MODEL=gpt-live-1
SNG_INTELLIGENCE_LIVE_DELEGATION_MODEL=gpt-6-luna
SNG_INTELLIGENCE_LIVE_VOICE=marin
SNG_INTELLIGENCE_LIVE_TIMEOUT_SECONDS=30
# Live authorization/credential lifetime (1..600 s); expiry also closes sideband.
SNG_INTELLIGENCE_LIVE_LIFETIME_SECONDS=600


# Performance 2D. Candidate budgets; validate quality on your actual workload.
# Current GPT-Live WebRTC schema has no configurable Realtime server/semantic VAD.
SNG_INTELLIGENCE_LIVE_DELEGATION_REASONING_EFFORT=low
SNG_INTELLIGENCE_LIVE_DELEGATION_MAX_OUTPUT_TOKENS=1024
# priority is opt-in; model/project access and cost apply. Never enabled silently.
SNG_INTELLIGENCE_LIVE_SERVICE_TIER=auto
# Empty model preserves SNG_INTELLIGENCE_MODEL for Live. Text chat is unchanged.
SNG_INTELLIGENCE_LIVE_AGENT_MODEL=
SNG_INTELLIGENCE_LIVE_AGENT_REASONING_EFFORT=low
SNG_INTELLIGENCE_LIVE_AGENT_MAX_OUTPUT_TOKENS=800
# Reasoning support verified for gpt-6-luna/sol/astra; see PERFORMANCE_2D.md.
# For other models explicitly leave the relevant REASONING_EFFORT empty (omit).

# Conversation 3A: fixed absolute lifetime, independent of Live credentials (1..3600 s).
SNG_INTELLIGENCE_CONVERSATION_TTL_SECONDS=1800

# Management Intelligence 4B: direct, per-request document analysis (no Files API).
# Empty model falls back to SNG_INTELLIGENCE_MODEL. Use a model supporting file/image inputs.
SNG_INTELLIGENCE_DOCUMENT_MODEL=
SNG_INTELLIGENCE_DOCUMENT_MAX_FILE_BYTES=20000000
SNG_INTELLIGENCE_DOCUMENT_MAX_TOTAL_BYTES=30000000
SNG_INTELLIGENCE_DOCUMENT_PDF_DETAIL=auto
SNG_INTELLIGENCE_DOCUMENT_REASONING_EFFORT=low
SNG_INTELLIGENCE_DOCUMENT_MAX_OUTPUT_TOKENS=1600
